{
  "name": "agenttracker",
  "displayName": "AgentTracker",
  "description": "Track Jira work and agent-assisted development metrics locally in VS Code.",
  "version": "0.0.1",
  "publisher": "agenttracker",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agenttracker.configureJira",
        "title": "AgentTracker: Sign in to Jira"
      },
      {
        "command": "agenttracker.refresh",
        "title": "AgentTracker: Refresh"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agenttracker",
          "title": "AgentTracker",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "agenttracker": [
        {
          "type": "webview",
          "id": "agenttracker.dashboard",
          "name": "Work tracker"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "agenttracker.assistant",
        "name": "agenttracker",
        "fullName": "AgentTracker",
        "description": "Chat assistant for tracked Jira work; usage is accounted when you stop tracking",
        "isSticky": true
      }
    ],
    "configuration": {
      "title": "AgentTracker",
      "properties": {
        "agenttracker.jiraBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Jira base URL, for example https://company.atlassian.net"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.0"
  }
}
